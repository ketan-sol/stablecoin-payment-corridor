# Copy to backend/.env. Every value has a working local default; set what you change.

NETWORK=local                 # local (one Anvil chain plays Base and Arc) | testnet
PORT=4000

# Storage and queue. Unset: embedded Postgres in ./.data/pglite and an in-process queue (no Docker needed).
# DATABASE_URL=postgres://corridor:corridor@127.0.0.1:5432/corridor
# REDIS_URL=redis://127.0.0.1:6379

OPS_TOKEN=dev-ops-token
QUOTE_SECRET=dev-quote-secret-change-me
# TRAVEL_RULE_KEY=0x<32 bytes hex>   # AES-256-GCM key for IVMS101 payloads at rest (required on testnet)

QUOTE_TTL_SEC=60
FEE_BPS_STANDARD=30
FEE_BPS_PREMIUM=15
MIN_FEE_USD=0.50
LIMIT_PER_PAYMENT_STANDARD=10000
LIMIT_DAILY_STANDARD=50000
BANK_SETTLE_MS=3000           # mock bank transfer time; accounts starting with FAIL bounce

# Local network (the relayer key defaults to Anvil account #1)
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_DEPLOYMENT=../contracts/deployments/local.json

# Testnet network (NETWORK=testnet). Addresses from contracts/script/Deploy.s.sol; see contracts/AUDIT.md.
# RELAYER_KEY=0x...           # RELAYER + PAYOUT_OPERATOR + FREEZER on the escrow, COMPLIANCE_OFFICER on the registry, RELAYER on routers
# SOURCE_CHAINS=baseSepolia   # comma list of chains with a router: sepolia, baseSepolia
# ROUTER=0x...                # same address on every source chain (CREATE2 deploy via Deploy.s.sol)
# FEE_VAULT=0x...
# SEPOLIA_ROUTER=0x...        # per-chain addresses (e.g. deployed from Remix) override ROUTER / FEE_VAULT
# SEPOLIA_FEE_VAULT=0x...
# BASE_SEPOLIA_ROUTER=0x...
# BASE_SEPOLIA_FEE_VAULT=0x...
# ESCROW=0x...
# REGISTRY=0x...
# OFF_RAMP=0x...              # the off-ramp's settlement account, approved with escrow.setOffRamp
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ARC_RPC_URL=https://rpc.testnet.arc.io
# IRIS_URL=https://iris-api-sandbox.circle.com
# CONFIRMATIONS=1

# Post-quantum roles (optional): a PQAccount on Arc holds RELAYER, PAYOUT_OPERATOR and FREEZER on the escrow and
# COMPLIANCE_OFFICER on the registry; the backend signs each call with its hash-based key and RELAYER_KEY only pays
# gas. Deploy it with Deploy.s.sol pqAccount() (PQ_ROOT from this key), then move the roles to it.
# PQ_ACCOUNT=0x...
# PQ_SECRET=0x<32 bytes hex>  # the one-time keys derive from this: keep it like a private key
# PQ_SEED=0x<32 bytes hex>    # public per-tree tweak
# PQ_HEIGHT=10                # 2^10 = 1,024 signatures, then rotate; ~6 s to build the tree at startup
