# Copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NETWORK=local                      # local | testnet
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# Testnet RPCs (defaults: publicnode for Sepolia, viem's for Base Sepolia, rpc.testnet.arc.io for Arc)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# With a Reown (WalletConnect) project ID the app uses Reown AppKit; without one, the browser wallet.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
